# Example .env for mailproxy
# Copy to .env and edit as needed, then run `make up`.

# No required variables for the base stack (dovecot + postfix + fetcher).
# All account credentials live in accounts.yml.

# Uncomment to start Roundcube web UI on :8080 together with the main stack.
# ENABLE_ROUNDCUBE=true

# ---------------------------------------------------------------------------
# IMAP (Dovecot)
# IMAP_LISTEN:  bind address for port 143 (plain / STARTTLS)
# IMAPS_LISTEN: bind address for port 993 (IMAPS, only relevant for TLS=2/3)
#
# Recommended combinations:
#   TLS=1: IMAP_LISTEN=127.0.0.1, IMAPS_LISTEN=127.0.0.1  (local only)
#   TLS=2: IMAP_LISTEN=0.0.0.0,   IMAPS_LISTEN=0.0.0.0    (STARTTLS + IMAPS)
#   TLS=3: IMAP_LISTEN=127.0.0.1, IMAPS_LISTEN=0.0.0.0    (plain blocked externally,
#                                                            IMAPS for clients)
# IMAP_TLS: 1 = plain, 2 = STARTTLS available, 3 = STARTTLS required + IMAPS
# ---------------------------------------------------------------------------
# IMAP_LISTEN=127.0.0.1
# IMAP_PORT=143
# IMAPS_LISTEN=127.0.0.1
# IMAPS_PORT=993
# IMAP_TLS=1

# ---------------------------------------------------------------------------
# SMTP (Postfix, client-facing submission port)
# SMTP_LISTEN: same as above
# SMTP_TLS: 1 = plain, 2 = STARTTLS available, 3 = STARTTLS required
# ---------------------------------------------------------------------------
# SMTP_LISTEN=127.0.0.1
# SMTP_PORT=587
# SMTP_TLS=1

# ---------------------------------------------------------------------------
# Roundcube web UI
# ---------------------------------------------------------------------------
# ROUNDCUBE_LISTEN=0.0.0.0
# ROUNDCUBE_PORT=8080
